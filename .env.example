GEMINI_API_KEY=
# Current default per official Gemini API model documentation; override if needed.
GEMINI_MODEL=gemini-3.8-flash
JALRAKSHAK_OFFLINE=0
# Optional: JALRAKSHAK_DB=data/jalrakshak.sqlite3

# Local ESP32 sensor API. Use 0.0.0.0 only on a trusted LAN, with a token.
SENSOR_API_HOST=127.0.0.1
SENSOR_API_PORT=8000
SENSOR_API_BASE_URL=http://127.0.0.1:8000
SENSOR_API_TOKEN=
SENSOR_STALE_SECONDS=120
SENSOR_DEMO_MODE=0
SENSOR_DRY_THRESHOLD_PERCENT=30
